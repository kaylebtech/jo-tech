# Copy this file to .env and fill in real values.

# Postgres connection string — get a free one from https://neon.tech or https://supabase.com
#
# If using Supabase: this app runs on Vercel's serverless functions, so you need
# TWO different connection strings from Supabase's "Connect" dialog:
#   DATABASE_URL — the "Transaction pooler" string (port 6543). Append
#                   `&pgbouncer=true` to it. Used by the app at runtime.
#   DIRECT_URL   — the direct connection string (port 5432, no pooler),
#                   also shown in the same dialog. Used only by
#                   `prisma migrate` / the Prisma CLI, never at runtime.
# If using Neon or local Postgres: just set DATABASE_URL, leave DIRECT_URL unset.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://jotechgadgetshub.com"

# WhatsApp business number in E.164 format, digits only, no leading +
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"

# Cloudinary — from your Cloudinary dashboard (server-only, never expose these to the client)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Used only by `prisma db seed` to create the first admin login — change the password after first login
SEED_ADMIN_EMAIL="admin@jotechgadgetshub.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
