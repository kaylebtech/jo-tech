// JO TECH GADGETS HUB — database schema
// Domain model: product catalog + WhatsApp-inquiry commerce (no payment gateway) + CMS content.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCondition {
  NEW
  UK_USED
  REFURBISHED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum InquiryType {
  BUY
  SELL
  SWAP
  REPAIR
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  icon        String? // lucide icon name
  position    Int      @default(0)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  brand          String?
  price          Decimal?         @db.Decimal(12, 2)
  compareAtPrice Decimal?         @db.Decimal(12, 2)
  condition      ProductCondition @default(NEW)
  stockStatus    StockStatus      @default(IN_STOCK)
  specs          Json?
  featured       Boolean          @default(false)
  metaTitle      String?
  metaDescription String?
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  reviews        Review[]
  inquiries      Inquiry[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  altText   String?
  position  Int     @default(0)
}

/// A WhatsApp-driven lead/inquiry (buy, sell, swap, or repair request) — not a paid checkout order.
model Inquiry {
  id            String        @id @default(cuid())
  type          InquiryType   @default(BUY)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String?
  message       String?
  status        InquiryStatus @default(NEW)
  source        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  authorAvatarUrl String?
  rating     Int
  comment    String?
  source     String   @default("site") // "site" | "google"
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([approved])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  coverImageUrl   String?
  category        String?
  author          String    @default("JO TECH Gadgets Hub")
  published       Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String
  category  String // "shop-inside" | "shop-outside" | "products" | "repair-before" | "repair-after"
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Singleton row (id always "singleton") holding CMS-editable homepage/business content.
model SiteSettings {
  id              String   @id @default("singleton")
  heroHeadline    String   @default("Nigeria's Trusted Gadget Marketplace")
  heroSubheadline String   @default("Buy • Sell • Swap • Repair")
  heroImageUrl    String?
  businessHours   Json
  whatsappNumber  String
  phoneNumbers    String[]
  email           String?
  addressLine     String
  city            String   @default("Lagos")
  googleMapsUrl   String?
  googleRating    Decimal? @db.Decimal(2, 1)
  socialLinks     Json
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
